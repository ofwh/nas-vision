{
  "id": "weather",
  "name": "plugin.name",
  "description": "plugin.description",
  "icon": "./assets/icon.png",
  "status": "on",
  "size": {
    "width": 960,
    "height": 760
  },
  "transparent": true,
  "header": false,
  "fit": true,
  "resizable": false,
  "closeOnOverlay": true,
  "configs": [
    {
      "key": "provider",
      "label": "plugin.configs.provider.label",
      "type": "combobox",
      "value": "qweather",
      "defaults": "qweather",
      "required": true,
      "options": [
        {
          "label": "plugin.configs.provider.options.qweather.label",
          "value": "qweather",
          "description": "plugin.configs.provider.options.qweather.description"
        },
        {
          "label": "plugin.configs.provider.options.caiyun.label",
          "value": "caiyun",
          "description": "plugin.configs.provider.options.caiyun.description"
        }
      ]
    },
    {
      "key": "qweatherApiKey",
      "label": "plugin.configs.qweatherApiKey.label",
      "type": "input",
      "value": "",
      "defaults": "",
      "secret": true,
      "required": true,
      "conditions": {
        "key": "provider",
        "value": "qweather"
      }
    },
    {
      "key": "caiyunToken",
      "label": "plugin.configs.caiyunToken.label",
      "type": "input",
      "value": "",
      "defaults": "",
      "secret": true,
      "required": true,
      "conditions": {
        "key": "provider",
        "value": "caiyun"
      }
    },
    {
      "key": "qweatherHost",
      "label": "plugin.configs.qweatherHost.label",
      "type": "input",
      "value": "",
      "defaults": "",
      "required": true,
      "conditions": {
        "key": "provider",
        "value": "qweather"
      }
    },
    {
      "key": "temperatureUnit",
      "label": "plugin.configs.temperatureUnit.label",
      "type": "combobox",
      "value": "celsius",
      "defaults": "celsius",
      "required": true,
      "options": [
        {
          "label": "plugin.configs.temperatureUnit.options.celsius.label",
          "value": "celsius"
        },
        {
          "label": "plugin.configs.temperatureUnit.options.fahrenheit.label",
          "value": "fahrenheit"
        }
      ]
    },
    {
      "key": "pressureUnit",
      "label": "plugin.configs.pressureUnit.label",
      "type": "combobox",
      "value": "hectopascal",
      "defaults": "hectopascal",
      "required": true,
      "options": [
        {
          "label": "plugin.configs.pressureUnit.options.hectopascal.label",
          "value": "hectopascal"
        },
        {
          "label": "plugin.configs.pressureUnit.options.pascal.label",
          "value": "pascal"
        }
      ]
    },
    {
      "key": "windSpeedUnit",
      "label": "plugin.configs.windSpeedUnit.label",
      "type": "combobox",
      "value": "kilometer_per_hour",
      "defaults": "kilometer_per_hour",
      "required": true,
      "options": [
        {
          "label": "plugin.configs.windSpeedUnit.options.kilometer_per_hour.label",
          "value": "kilometer_per_hour"
        },
        {
          "label": "plugin.configs.windSpeedUnit.options.meter_per_second.label",
          "value": "meter_per_second"
        },
        {
          "label": "plugin.configs.windSpeedUnit.options.mile_per_hour.label",
          "value": "mile_per_hour"
        }
      ]
    },
    {
      "key": "visibilityUnit",
      "label": "plugin.configs.visibilityUnit.label",
      "type": "combobox",
      "value": "kilometer",
      "defaults": "kilometer",
      "required": true,
      "options": [
        {
          "label": "plugin.configs.visibilityUnit.options.kilometer.label",
          "value": "kilometer"
        },
        {
          "label": "plugin.configs.visibilityUnit.options.meter.label",
          "value": "meter"
        }
      ]
    },
    {
      "key": "precipitationUnit",
      "label": "plugin.configs.precipitationUnit.label",
      "type": "combobox",
      "value": "millimeter",
      "defaults": "millimeter",
      "required": true,
      "options": [
        {
          "label": "plugin.configs.precipitationUnit.options.millimeter.label",
          "value": "millimeter"
        },
        {
          "label": "plugin.configs.precipitationUnit.options.inch.label",
          "value": "inch"
        }
      ]
    }
  ],
